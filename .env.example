# Betmaxxing — example environment file.
# Copy to `.env` and fill in. NEVER commit `.env`. No real secret belongs in this file.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# demo | backtest | paper | live_analysis
BETMAXXING_MODE=demo
BETMAXXING_DISPLAY_TIMEZONE=Europe/Paris
BETMAXXING_LOG_LEVEL=INFO
# Deterministic seed used by the demo provider only.
BETMAXXING_DEMO_SEED=20260804

# ---------------------------------------------------------------------------
# Database (UTC storage). SQLite is for local dev/tests only.
# ---------------------------------------------------------------------------
BETMAXXING_DATABASE_URL=sqlite+pysqlite:///./betmaxxing.db
# Persistent deployment:
# BETMAXXING_DATABASE_URL=postgresql+psycopg://betmaxxing:CHANGE_ME@localhost:5432/betmaxxing

# ---------------------------------------------------------------------------
# Scan window & eligibility thresholds (ALL PROVISIONAL until out-of-sample
# validation passes — see docs/validation-protocol.md).
# ---------------------------------------------------------------------------
BETMAXXING_WINDOW_HOURS=24
BETMAXXING_MIN_EV=0.03
# Applied only when a usable uncertainty method exists. Outside demo mode none
# does yet, so candidates are rejected with UNCERTAINTY_UNAVAILABLE (D-019).
BETMAXXING_MIN_CONSERVATIVE_EV=0.0
BETMAXXING_MAX_PROB_HALF_WIDTH=0.08
BETMAXXING_MAX_ODDS_AGE_SECONDS=900
BETMAXXING_MIN_DATA_QUALITY=0.60
BETMAXXING_MIN_ODDS=1.20
BETMAXXING_MAX_ODDS=8.00
# multiplicative | additive | power | shin
BETMAXXING_DEVIG_METHOD=shin
# z used by the DEMO-ONLY synthetic interval (D-019). It is not a real
# confidence level and has no effect outside demo mode.
BETMAXXING_PROB_INTERVAL_Z=1.6448536269514722

# ---------------------------------------------------------------------------
# Bankroll / staking. Suggestions are OFF until a bankroll is configured.
# ---------------------------------------------------------------------------
BETMAXXING_STAKING_ENABLED=false
BETMAXXING_BANKROLL=0
BETMAXXING_CURRENCY=EUR
BETMAXXING_UNIT_PCT_OF_BANKROLL=0.01
BETMAXXING_KELLY_FRACTION=0.25
BETMAXXING_MAX_STAKE_PCT_OF_BANKROLL=0.01
BETMAXXING_MAX_DAILY_EXPOSURE_PCT=0.05

# ---------------------------------------------------------------------------
# Challenge — Montante. Simulation module, OFF by default.
# When false, every /challenges route answers 404.
# ---------------------------------------------------------------------------
BETMAXXING_CHALLENGE_ENABLED=false

# ---------------------------------------------------------------------------
# Providers. Empty key => provider unavailable => DATA_UNAVAILABLE, never a
# silent substitution.
# ---------------------------------------------------------------------------
# Winamax has no authorized public odds API known to this project. `manual`
# means: use `betmaxxing odds import <file.csv>`. Winamax may also appear as a
# bookmaker inside The Odds API — see BETMAXXING_BOOKMAKERS below.
BETMAXXING_WINAMAX_MODE=manual

# demo | the_odds_api
BETMAXXING_ODDS_PROVIDER=demo

# --- The Odds API v4 (status: IMPLEMENTED_UNVERIFIED) ----------------------
# No live call has confirmed coverage. Run scripts/smoke_the_odds_api.py with
# your own key to find out what you actually have.
BETMAXXING_THE_ODDS_API_KEY=
BETMAXXING_THE_ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
BETMAXXING_BOOKMAKERS=winamax_fr
BETMAXXING_THE_ODDS_API_REGIONS=eu,fr
BETMAXXING_THE_ODDS_API_SPORT_KEYS=soccer_france_ligue_one,soccer_epl,soccer_spain_la_liga,tennis_atp_aus_open_singles
# Credit budgets. A request estimated above these is refused BEFORE it runs,
# so a misconfiguration cannot quietly spend a month of quota.
BETMAXXING_PROVIDER_BUDGET_PER_SCAN=50
BETMAXXING_PROVIDER_BUDGET_PER_DAY=450

# DEPRECATED: generic key, kept temporarily for compatibility. Prefer
# BETMAXXING_THE_ODDS_API_KEY; a warning is emitted if only this one is set.
BETMAXXING_ODDS_API_KEY=
BETMAXXING_ODDS_API_BASE_URL=

BETMAXXING_SPORTSDATA_PROVIDER=demo
BETMAXXING_SPORTSDATA_API_KEY=
BETMAXXING_PROVIDER_TIMEOUT_SECONDS=10
BETMAXXING_PROVIDER_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Notifications — opt-in, never sent during tests.
# ---------------------------------------------------------------------------
BETMAXXING_NOTIFICATIONS_ENABLED=false
BETMAXXING_NOTIFICATION_CHANNELS=console
BETMAXXING_TELEGRAM_BOT_TOKEN=
BETMAXXING_TELEGRAM_CHAT_ID=
BETMAXXING_SMTP_HOST=
BETMAXXING_SMTP_PORT=587
BETMAXXING_SMTP_USERNAME=
BETMAXXING_SMTP_PASSWORD=
BETMAXXING_EMAIL_FROM=
BETMAXXING_EMAIL_TO=
BETMAXXING_QUIET_HOURS_START=23
BETMAXXING_QUIET_HOURS_END=8

# ---------------------------------------------------------------------------
# Scheduler (separate process from the web server).
# ---------------------------------------------------------------------------
BETMAXXING_SCHEDULER_ENABLED=false
BETMAXXING_SCAN_TIMES=08:00,12:00,18:00
BETMAXXING_MILESTONES_HOURS_BEFORE=24,12,6,2,1,0.25

# ---------------------------------------------------------------------------
# Optional LLM used ONLY to phrase an already-validated evidence pack.
# It can never produce or alter a probability or an eligibility decision.
# ---------------------------------------------------------------------------
BETMAXXING_LLM_ENABLED=false
BETMAXXING_LLM_PROVIDER=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
BETMAXXING_API_HOST=127.0.0.1
BETMAXXING_API_PORT=8000
BETMAXXING_API_TOKEN=
BETMAXXING_CORS_ORIGINS=http://localhost:5173
